# =============================================================================
# Environment configuration for the Inventory Reservation & Order Processing
# Service. Copy this file to `.env` and adjust values for your environment.
# NEVER commit a real `.env` file with production secrets.
# =============================================================================

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# Public API base path prefix
API_V1_PREFIX=/api/v1

# --- Database (PostgreSQL) ---
# Used by the API, the Celery worker, and the outbox relay process.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/inventory_db
# Separate database used only when running the automated test suite locally
# (docker-compose exposes postgres on localhost:5432 for this purpose).
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/inventory_db_test

# --- Redis / Celery (message queue for asynchronous order processing) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- JWT Authentication ---
JWT_SECRET=please-change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Bootstrap admin account ---
# Created automatically on startup if no user with this email exists yet.
# Lets you obtain an ADMIN token immediately on a fresh `docker compose up`.
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# --- Inventory reservations ---
# How long a reservation stays valid before the cleanup worker releases it.
RESERVATION_TIMEOUT_MINUTES=15
# How often (in seconds) the reservation-cleanup Celery Beat task runs.
RESERVATION_CLEANUP_INTERVAL_SECONDS=60

# --- Outbox relay ---
# How often (in seconds) the outbox relay process polls for new events to
# publish onto the Celery queue.
OUTBOX_POLL_INTERVAL_SECONDS=1

# --- Payment retry policy (Bonus: retry with backoff) ---
# Comma separated backoff delays (seconds) applied between retry attempts
# for a "fail_retryable" simulated payment before the order is marked FAILED.
PAYMENT_RETRY_BACKOFF_SECONDS=5,30
PAYMENT_MAX_ATTEMPTS=3
